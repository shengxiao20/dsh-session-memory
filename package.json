{
  "name": "@shengxiao04/dsh-session-memory",
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org" },
  "version": "0.1.3",
  "description": "Local DSH session search and bounded original-history reads. / DSH 自身会话检索与按需原文读取。",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22", "dsh": "0.2.1-rc.3" },
  "keywords": ["dsh", "cordis", "session", "memory", "local-search"],
  "exports": { ".": "./index.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["index.js", "src/", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "README_zh.md", "docs/", "scripts/", "tests/", "LICENSE"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "scripts": { "check": "node --check index.js && node --check src/memory.js && node --check src/schemas.js", "test": "node --test tests/*.test.js", "test:native": "node scripts/native-smoke.js", "test:all": "npm run check && npm test" }
}
