{
  "name": "@shengxiao04/dsh-session-memory",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "version": "0.3.0",
  "description": "DSH-only persisted source-turn memory: plugin-owned SQLite, entity ranking, global/project dedup, local/remote Jev, history reads/stats/backfill and Obsidian. / 仅持久化 DSH 会话源 turn 召回、插件自有索引及历史管理。",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "dsh": "0.2.1-rc.5"
  },
  "keywords": [
    "dsh",
    "cordis",
    "session",
    "memory",
    "local-search"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "src/",
    "client/",
    "dist/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README_zh.md",
    "CHANGELOG.md",
    "docs/",
    "scripts/",
    "tests/",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.js",
    "check": "node --check index.js && for file in src/*.js client/*.js scripts/*.js; do node --check \"$file\" || exit; done",
    "test": "node --test tests/*.test.js",
    "test:native": "node scripts/native-smoke.js && node scripts/native-config-smoke.js",
    "test:browser": "node scripts/browser-config-smoke.js",
    "test:all": "npm run build && npm run check && npm test"
  },
  "dependencies": {
    "@deepseek-ai/cosmokit": "~1.8.6",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-test-renderer": "^18.3.1"
  }
}
